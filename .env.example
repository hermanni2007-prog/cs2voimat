# Kopioi tama tiedostoksi ".env" ja tayta oikea arvo.
# Rekisteroidy osoitteessa https://oddspapi.io ja hae API-avain sielta.
ODDSPAPI_API_KEY=REPLACE_ME

# Kuinka monta minuuttia ennen ottelun alkua kerroin tallennetaan "sulkeutuvaksi".
# HUOM: pidettava >= ajastuksen pollausvali (scheduler/register_task.ps1, oletus 15 min),
# jotta jokaiselle ottelulle taataan vahintaan yksi pollaus taman ikkunan sisalla.
CLOSING_WINDOW_MINUTES=25

# Kuinka monta bookmakeria haetaan per pyynto (pidetaan pienena kiintioiden sailyttamiseksi).
ODDSPAPI_BOOKMAKERS=pinnacle
