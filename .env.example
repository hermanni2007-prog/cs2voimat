# Kopioi tama tiedostoksi ".env" ja tayta oikea arvo.
# Rekisteroidy osoitteessa https://oddspapi.io ja hae API-avain sielta.
ODDSPAPI_API_KEY=REPLACE_ME

# Kuinka monta minuuttia ennen ottelun alkua kerroin tallennetaan "sulkeutuvaksi".
# HUOM: pidettava >= GitHub Actionsin pollausvali (.github/workflows/collect_odds.yml, 5 min),
# jotta jokaiselle ottelulle taataan vahintaan yksi pollaus taman ikkunan sisalla.
CLOSING_WINDOW_MINUTES=10

# HUOM bookmaker-valinnasta: Coolbet EI ole vahvistettu "sharp" (markkinatehokas) kirja
# yhdelläkään riippumattomalla sharp-bookmaker-listauksella - vain Pinnacle on. Coolbet
# valittiin hinnan takia (ks. README/status-sivu). Jos CLV-tulokset alkavat näyttää
# epäilyttäviltä, tämä on ensimmäinen asia jota syytä epäillä.

# Kuinka monta bookmakeria haetaan per pyynto (pidetaan pienena kiintioiden sailyttamiseksi).
ODDSPAPI_BOOKMAKERS=coolbet
